{
  "private": true,
  "name": "dropin-template",
  "version": "1.0.1",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "license": "MIT",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "files": [
    "*"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "elsie concurrently 'pnpm run storybook' 'pnpm run serve'",
    "storybook": "elsie storybook",
    "build:storybook": "elsie storybook build --disable-telemetry",
    "serve": "elsie concurrently 'elsie serve' 'elsie wait-on tcp:${PORT:=3002} && alive-server ./examples/html-host --port=3000 --watch=../../dist/reload'",
    "lint": "elsie lint --max-warnings=0",
    "format": "elsie format",
    "format:check": "elsie format --check",
    "type-check": "tsc --noEmit",
    "test": "elsie test",
    "build": "elsie build",
    "analyze": "ANALYZE=true elsie build",
    "changeset": "elsie changeset",
    "version": "elsie changeset version"
  },
  "prettier": "@adobe-commerce/elsie/configs/prettier.js",
  "dependencies": {
    "@adobe-commerce/elsie": "3.0.0",
    "@adobe-commerce/event-bus": "~1.1.2",
    "@adobe-commerce/fetch-graphql": "~1.3.2",
    "@adobe-commerce/storefront-design": "~1.1.2",
    "@dropins/build-tools": "~1.2.2",
    "@preact/signals": "^2.3.1",
    "preact": "~10.29.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "alive-server": "^1.3.0",
    "typescript": "~6.0.3"
  }
}
